{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/**/*.ts",
    "src/preload/*.d.ts",
    "src/renderer/**/translation.json",
    "src/renderer/i18n.ts",
    "src/renderer/types/multiViewerAPI.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,

    "strict": true,
    "types": ["jquery", "bootstrap"]
  }
}
