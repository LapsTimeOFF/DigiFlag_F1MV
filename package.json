{
  "name": "digiflag-f1mv",
  "productName": "DigiFlag-F1MV",
  "version": "2.8.5",
  "description": "DigiFlag for MultiViewer",
  "main": "./out/main/main.js",
  "license": "MIT",
  "type": "module",
  "author": "DigiFlag Team",
  "contributors": [
    {
      "name": "LapsTimeOFF",
      "url": "https://github.com/LapsTimeOFF"
    },
    {
      "name": "TheBaconCat",
      "url": "https://github.com/TheBaconCat"
    },
    {
      "name": "JJwatMyself",
      "url": "https://github.com/JJwatMyself"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LapsTimeOFF/DigiFlag_F1MV.git"
  },
  "bugs": {
    "url": "https://github.com/LapsTimeOFF/DigiFlag_F1MV/issues"
  },
  "scripts": {
    "dev": "electron-vite build && electron-vite dev -w ",
    "preview": "electron-vite build && electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --config --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --config --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --config --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "format:write": "prettier --write \"**/*.{ts,js,json,css,md,yml}\" --cache",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "address": "^2.0.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "i18next": "^25.7.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-backend": "^3.0.2",
    "jquery": "^3.7.1",
    "jquery-i18next": "^1.2.1",
    "npm_f1mv_api": "^1.4.8"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.1",
    "@types/bootstrap": "^5.2.10",
    "@types/express": "^5.0.6",
    "@types/imagemin-gifsicle": "^7.0.4",
    "@types/imagemin-webp": "^7.0.3",
    "@types/jquery": "^3.5.33",
    "@types/node": "^24.10.1",
    "@types/request": "^2.48.13",
    "@vheemstra/vite-plugin-imagemin": "^2.2.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.3.3",
    "electron-log": "^5.4.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-webp": "^8.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.6"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --fix",
    "*.{js,ts,css,md}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cwebp-bin",
      "electron",
      "electron-winstaller",
      "esbuild",
      "gifsicle"
    ],
    "overrides": {
      "got@<11.8.5": ">=11.8.5",
      "semver-regex@<3.1.3": ">=3.1.3",
      "semver-regex@<3.1.4": ">=3.1.4",
      "http-cache-semantics@<4.1.1": ">=4.1.1",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "tar@=7.5.1": ">=7.5.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1"
    }
  }
}
